# IBM watsonx credentials
# Copy this file to .env and fill in your real values — never commit .env to source control

# Your IBM Cloud API key
WATSONX_API_KEY=your_api_key_here

# The watsonx project ID (found in the watsonx.ai project settings)
WATSONX_PROJECT_ID=your_project_id_here

# The regional base URL for the watsonx inference API
# Example: https://us-south.ml.cloud.ibm.com
WATSONX_URL=https://<region>.ml.cloud.ibm.com

# (Optional) watsonx model ID — defaults to meta-llama/llama-3-3-70b-instruct
WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# (Optional) Port the Express server listens on — defaults to 3000
PORT=3000
